// M1 · 数据中心 · 表设计提案
// ⚠️ 设计提案。实现后以 bingo-backend/prisma/models/*.prisma 为准。
//
// ── 外部引用(只读,不在本模块定义)──────────────────────
//   User / LoginRecord        → owner: M2-用户管理
//   Transaction / *Order      → owner: M3-财务管理
//   BetRecords / ActivityClaim→ owner: M4-玩法中心
//   Channel                   → owner: M5-代理渠道
// ────────────────────────────────────────────────────
// 原则:本模块只写汇总表,业务表一律只读。

/// 全站每日汇总(报表主表)
model DailySummary {
  id             String   @id @default(cuid())
  /// 统计日期(按运营时区切日,见「待探讨」)
  statDate       DateTime @map("stat_date") @db.Date
  currency       String
  registerCount  Int      @default(0) @map("register_count")
  ftdCount       Int      @default(0) @map("ftd_count")        // 首充人数
  rechargeAmount Decimal  @default(0) @map("recharge_amount") @db.Decimal(20, 8)
  rechargeCount  Int      @default(0) @map("recharge_count")
  withdrawAmount Decimal  @default(0) @map("withdraw_amount") @db.Decimal(20, 8)
  betAmount      Decimal  @default(0) @map("bet_amount") @db.Decimal(20, 8)
  payoutAmount   Decimal  @default(0) @map("payout_amount") @db.Decimal(20, 8)
  /// GGR = betAmount - payoutAmount
  ggr            Decimal  @default(0) @db.Decimal(20, 8)
  /// NGR = GGR - 彩金成本 - 返佣
  ngr            Decimal  @default(0) @db.Decimal(20, 8)
  bonusCost      Decimal  @default(0) @map("bonus_cost") @db.Decimal(20, 8)
  activeUsers    Int      @default(0) @map("active_users")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([statDate, currency])
  @@map("daily_summary")
}

/// 分渠道每日汇总
model ChannelDailySummary {
  id             String   @id @default(cuid())
  statDate       DateTime @map("stat_date") @db.Date
  channelId      String   @map("channel_id")   // FK → M5.Channel.id
  currency       String
  registerCount  Int      @default(0) @map("register_count")
  ftdCount       Int      @default(0) @map("ftd_count")
  rechargeAmount Decimal  @default(0) @map("recharge_amount") @db.Decimal(20, 8)
  withdrawAmount Decimal  @default(0) @map("withdraw_amount") @db.Decimal(20, 8)
  ggr            Decimal  @default(0) @db.Decimal(20, 8)
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([statDate, channelId, currency])
  @@map("channel_daily_summary")
}

/// 分游戏每日汇总
model GameDailySummary {
  id           String   @id @default(cuid())
  statDate     DateTime @map("stat_date") @db.Date
  platformId   String?  @map("platform_id")   // FK → M4.GamePlatform.id
  gameCode     String   @map("game_code")
  currency     String
  betAmount    Decimal  @default(0) @map("bet_amount") @db.Decimal(20, 8)
  payoutAmount Decimal  @default(0) @map("payout_amount") @db.Decimal(20, 8)
  ggr          Decimal  @default(0) @db.Decimal(20, 8)
  betCount     Int      @default(0) @map("bet_count")
  playerCount  Int      @default(0) @map("player_count")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([statDate, gameCode, currency])
  @@map("game_daily_summary")
}

/// 留存事实表:某日注册的用户,在第 N 日的回访情况
model UserRetentionFact {
  id            String   @id @default(cuid())
  cohortDate    DateTime @map("cohort_date") @db.Date  // 注册日
  channelId     String?  @map("channel_id")
  /// 间隔天数:1 / 7 / 30
  dayOffset     Int      @map("day_offset")
  cohortSize    Int      @map("cohort_size")
  retainedCount Int      @map("retained_count")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@unique([cohortDate, channelId, dayOffset])
  @@map("user_retention_fact")
}

/// 活动 ROI 日报:发放成本 vs 带来存款
model ActivityRoiDaily {
  id             String   @id @default(cuid())
  statDate       DateTime @map("stat_date") @db.Date
  /// 活动标识(元数据,不建外键)
  activityCode   String   @map("activity_code")
  currency       String
  claimCount     Int      @default(0) @map("claim_count")
  claimUserCount Int      @default(0) @map("claim_user_count")
  /// 发放彩金总额 = 成本
  bonusCost      Decimal  @default(0) @map("bonus_cost") @db.Decimal(20, 8)
  /// 参与用户当日充值
  rechargeAmount Decimal  @default(0) @map("recharge_amount") @db.Decimal(20, 8)
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([statDate, activityCode, currency])
  @@map("activity_roi_daily")
}
