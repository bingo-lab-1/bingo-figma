// 00-shared · 跨模块共享枚举
// 仅放被 2 个以上模块引用的枚举。业务表一律归属具体模块。

/// 币种类型:加密 / 法币
enum CurrencyKind {
  crypto
  fiat
}

/// 客户端平台(注册/登录/投注来源)
enum PlatformType {
  h5
  pwa
  apk
  ios
  web
}

/// 通用审核状态(提现审核、KYC、代理结算共用)
enum ReviewStatus {
  pending    // 待审核
  autoPassed // 自动过审
  manualPass // 人工通过
  rejected   // 拒绝
  cancelled  // 取消
}

/// 通用启用状态
enum EnableStatus {
  enabled
  disabled
}
