// ============ 新增:封禁记录 ============

/// 封禁/解封流水。现有 User.status 只存当前态,缺历史与原因
model UserBanRecord {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")        // FK → User.id
  banType    BanType   @map("ban_type")
  reason     String
  /// 后台操作人
  operatorId String    @map("operator_id")    // FK → M7.Account.id
  bannedAt   DateTime  @default(now()) @map("banned_at")
  /// null = 永久封禁
  expiresAt  DateTime? @map("expires_at")
  unbannedAt DateTime? @map("unbanned_at")
  unbanOperatorId String? @map("unban_operator_id")
  unbanReason     String? @map("unban_reason")

  @@index([userId, bannedAt])
  @@map("user_ban_record")
}

enum BanType {
  login   // 禁止登录
  fund    // 禁止出入金
  game    // 禁止投注
  full    // 全面封禁
}

// ============ 新增:点控记录 ============

/// 赢率干预记录(风控/运营对特定用户的干预)
model PointControlRecord {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  operatorId String   @map("operator_id")
  /// 干预参数(具体形态待探讨)
  config     Json
  reason     String
  startAt    DateTime @map("start_at")
  endAt      DateTime? @map("end_at")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("point_control_record")
}

