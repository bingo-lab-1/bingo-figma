/// 法币与汇率(⬜ 是否需要待探讨:竞品主打 BRL)
model FiatCurrency {
  id           String   @id @default(cuid())
  code         String   @unique          // BRL / USD / ...
  symbol       String                    // R$ / $
  /// 对基准币的汇率
  rate         Decimal  @db.Decimal(20, 8)
  /// 汇率来源:manual | api
  rateSource   String   @default("manual") @map("rate_source")
  decimals     Int      @default(2)
  enabled      Boolean  @default(true)
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("fiat_currency")
}

